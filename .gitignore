# Obsidian の端末ごとの状態（共有しない）
.obsidian/workspace*.json
.obsidian/cache

# ユーザーが入れたプラグイン本体・テーマ（設定 data.json と snippets は同梱するのでコミットする）
.obsidian/plugins/*/main.js
.obsidian/plugins/*/manifest.json
.obsidian/plugins/*/styles.css
.obsidian/themes/

# ゴミ箱
.trash/

# OS が作るファイル
.DS_Store
Thumbs.db

# 秘密情報（誤ってVaultに置いた場合の保険）
.env
*.key
